# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# internal QA / agent tool output — never part of the app
tool-results/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ALL untracked since Task 21 (the server's .env holds the
# owner's secrets; editing it must never conflict with git pull).
# Only the .env.example template stays committed.
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Local MariaDB runtime (sandbox dev DB — never deploy)
mysql-runtime/
db/legacy-sqlite.db
logs/

# Runtime-stored WhatsApp group images (regenerated per environment, robots-blocked)
/media/

# Sitemaps — RUNTIME-GENERATED artifacts (Task 35). Never commit them again:
# Next.js 16 scans public/ only once at boot, so committed copies were served
# stale-or-not-at-all; the /sitemap.xml + /sitemaps/* route handlers read the
# generated files from disk per request. The first hit after a deploy
# auto-regenerates, and the crons keep them fresh.
/public/sitemap.xml
/public/sitemaps/

# --- Repo hygiene: sandbox/QA/agent artifacts are NEVER part of the app ---
# Session logs, agent notes, QA screenshots, sandbox runtime scripts, legacy
# local DBs and scratch uploads live on the dev machine only — the GitHub repo
# must contain exactly what the production build needs, nothing else.
/worklog.md
/agent-ctx/
/tool-results/
/qa-*.png
/upload/
/download/
/examples/
/mini-services/
/tests/
/.zscripts/
/Caddyfile
/db/
/start-dev.sh
/start-mariadb.sh
*.pid

# Next.js config transpile temp artifacts (generated on hosts that must
# transpile next.config.ts; we ship .mjs so these should never exist, but
# ignore them defensively)
next.config.compiled.js
*.next.config
*.next.config.*
