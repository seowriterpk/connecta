# ============================================================================
# .env.example — template. Copy to `.env` (or `.env.local`) and fill in.
#
# Since Task 21 ALL .env* files are git-ignored. The server's real `.env`
# belongs to the owner and is NEVER committed, so editing it on the server
# can never conflict with `git pull`.
#
# Priority (highest wins):
#   1. Real environment variables (hPanel → Node.js → Environment Variables)
#   2. .env.local
#   3. .env
# The production build (scripts/build.sh / npm run build) copies every
# existing .env* file into .next/standalone/ so the standalone server
# sees them. Cron scripts (scripts/crons/*.mjs) read the repo-root files.
# ============================================================================

# --- Database (MariaDB / MySQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_mysql_database

# --- Admin panel login -------------------------------------------------------
SESSION_SECRET=change-me-to-a-random-32-plus-char-string
ADMIN_USER=admin
ADMIN_PASS=change-me

# --- DataImpulse residential proxy (REQUIRED in production) -----------------
# WhatsApp blocks datacenter IPs — every invite-link check and group-image
# download must exit through this residential proxy. Format:
#   http://USERNAME__cr.us:PASSWORD@gw.dataimpulse.com:823
# (the __cr.us suffix routes through US residential IPs)
PROXY_URL=http://your-dataimpulse-user__cr.us:your-password@gw.dataimpulse.com:823

# --- Site --------------------------------------------------------------------
BASE_URL=https://yourdomain.com
NODE_ENV=production
