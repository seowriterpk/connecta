# ConectaGrupos — environment variables (copy to .env and fill in)
# Database (MariaDB/MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=grupos
DB_PASSWORD=
DB_NAME=gruposwhatsapp
# Prisma (only if using the optional SQLite path)
DATABASE_URL=file:./db/custom.db
# Admin panel credentials (choose a strong password!)
ADMIN_USER=admin
ADMIN_PASS=change-me
# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=change-me
# Optional outbound proxy for WhatsApp invite-link revalidation
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=
